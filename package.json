{
  "name": "hrms-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed:clean": "ts-node src/seedClean.ts",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute hrms --local --file=migrations/0001_init.sql",
    "db:init": "wrangler d1 execute hrms --remote --file=migrations/0001_init.sql"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "hono": "^4.12.32",
    "jose": "^6.2.4",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260726.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.9",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3",
    "wrangler": "^4.114.0"
  }
}
