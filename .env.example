PORT=4000

# Local MongoDB:
MONGO_URI=mongodb://localhost:27017/hrms

# MongoDB Atlas (SRV connection string): copy the string from Atlas > Connect > Drivers.
# Any special characters in the username/password (@, !, #, etc.) must be percent-encoded,
# e.g. in Node: encodeURIComponent("Aditi@!123") -> "Aditi%40!123"
# MONGO_URI=mongodb+srv://<user>:<url-encoded-password>@<cluster-host>/hrms?retryWrites=true&w=majority

JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
